# TEMPLATE. Deliberately NOT a .sops.yaml and not in the kustomization: a
# .sops.yaml containing REPLACE_ME is what made PR #2638 unmergeable, and an
# unencrypted secret matching the .sops.yaml path rule would fail decryption.
#
# Both values come from Cloudflare:
#
#   api-token  My Profile -> API Tokens -> Create Token
#              Permissions: Zone / DNS / Edit   (nothing else)
#              Zone Resources: Include / Specific zone / borgs.net
#              This can be the SAME token cert-manager uses -- both only need
#              Zone:DNS:Edit on the one zone -- but a second token is easy to
#              revoke independently.
#
#   tunnel-id  Zero Trust -> Networks -> Tunnels -> the tunnel -> its UUID.
#              This is the bare UUID, NOT the `--token` blob the cloudflared
#              Deployment uses. external-dns appends .cfargotunnel.com to it.
#
# Then:
#   cat > cluster/core/network-system/dns/external-dns-cloudflare/secret.sops.yaml <<'YAML'
#   ... (the body below, with real values)
#   YAML
#   sops --encrypt --in-place cluster/core/network-system/dns/external-dns-cloudflare/secret.sops.yaml
#
# and uncomment both entries in kustomization.yaml.
---
apiVersion: v1
kind: Secret
metadata:
  name: external-dns-cloudflare
  namespace: network-system
type: Opaque
stringData:
  api-token: PUT-THE-CLOUDFLARE-TOKEN-HERE-THEN-SOPS-ENCRYPT
  tunnel-id: PUT-THE-TUNNEL-UUID-HERE-THEN-SOPS-ENCRYPT
