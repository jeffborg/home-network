          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (camera, label) (increase(frigate_camera_events_total[1h]))",
          "legendFormat": "{{camera}} {{label}}"
        }
      ],
      "description": "Detected events by object type. Note frigate labels this metric `camera` while the fps metrics use `camera_name`."
    },
