      "description": "Frames actually run through the detector per camera."
    },
    {
      "type": "timeseries",
      "title": "Frames skipped/s",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
