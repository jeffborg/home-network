            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "frigate_skipped_fps",
          "legendFormat": "{{camera_name}}"
        }
      ],
      "description": "Non-zero means frames are being dropped before detection."
    },
    {
      "type": "timeseries",
      "title": "Events per hour",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "custom": {
