{
  "title": "Network SNMP Monitoring",
  "uid": "network-snmp",
  "tags": [
    "home",
    "network",
    "snmp",
    "ucg-ultra",
    "airmax"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "ucg_ultra",
        "label": "UCG Ultra",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ifDescr{instance=\"192.168.100.1\"}, ifDescr)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "default": "WAN"
      },
      {
        "type": "query",
        "name": "vlan_interfaces",
        "label": "VLAN Interfaces",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ifDescr{instance=\"192.168.100.1\"}, ifDescr)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "default": [
          "vlan10",
          "vlan58",
          "vlan18",
          "vlan22"
        ]
      },
      {
        "type": "query",
        "name": "airmax_devices",
        "label": "airMAX Devices",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ifDescr{job=\"snmp-airmax\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "default": [
          "192.168.10.184",
          "192.168.10.185",
          "192.168.10.186",
          "192.168.10.187"
        ]
      },
      {
        "type": "query",
        "name": "airmax_interfaces",
        "label": "airMAX Interfaces",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(ifDescr{job=\"snmp-airmax\"}, ifDescr)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "default": [
          "wlan0",
          "eth0"
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Internet (WAN) \u2014 UCG Ultra",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "WAN Traffic In/Out",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ifInOctets{instance=\"192.168.100.1\", ifDescr=\"$ucg_ultra\"}[5m]) * 8",
          "legendFormat": "In (bps)"
        },
        {
          "refId": "B",
          "expr": "rate(ifOutOctets{instance=\"192.168.100.1\", ifDescr=\"$ucg_ultra\"}[5m]) * 8",
          "legendFormat": "Out (bps)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "WAN Utilization %",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(rate(ifInOctets{instance=\"192.168.100.1\", ifDescr=\"$ucg_ultra\"}[5m]) + rate(ifOutOctets{instance=\"192.168.100.1\", ifDescr=\"$ucg_ultra\"}[5m])) * 8 / ifSpeed{instance=\"192.168.100.1\", ifDescr=\"$ucg_ultra\"} * 100",
          "legendFormat": "Utilization %"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "mappings": [],
          "max": 100,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
