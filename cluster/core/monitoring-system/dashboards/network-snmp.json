      "targets": [
        {
          "refId": "A",
          "expr": "ifOperStatus{instance=\"192.168.100.1\", ifDescr=\"$ucg_ultra\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              },
              "matchType": 1
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "DOWN",
                  "color": "red"
                }
              },
              "matchType": 1
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
