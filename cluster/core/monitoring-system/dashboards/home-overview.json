            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "mappings": []
        },
        "overrides": []
      },
      "description": "Needs phase 2 (#3059) to enable Longhorn's ServiceMonitor. Snapshot COW overhead shows up here as actual >> requested \u2014 see #3064."
    },
