{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],
  prConcurrentLimit: 20,
  rebaseWhen: 'conflicted',
  timezone: 'Australia/Sydney',
  kubernetes: {
    managerFilePatterns: [
      '/cluster/.+\\.yaml$/',
    ],
    ignorePaths: [
      'cluster/base/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/cluster/.+\\.yaml$/',
    ],
    ignorePaths: [
      'cluster/base/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *chart: (?<depName>.*?)\n *version: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/traefik/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n *tag: v(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/external-snapshotter/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?)\n *url: https://github\\.com/(?<depName>.*?)\\.git\n *ref:\n *tag: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/apps/mail/mailu/helmrelease.yaml/',
      ],
      matchStrings: [
        'docker=(?<depName>.*?)\n *mailuVersion: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.yaml$/',
      ],
      matchStrings: [
        'DOCKER_MODS: (?<depName>[^:]+):(?<currentValue>[^|\\n]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/external-dns/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?)\n *url: https://github\\.com/(?<depName>.*?)\\.git\n *ref:\n *tag: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/kube-prometheus-stack/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *tag: (?<depName>[a-zA-Z-]+)-(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/cert-manager/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n.*\\/(?<currentValue>.*?)\\/',
      ],
      datasourceTemplate: 'helm',
    },
  ],
  packageRules: [
    {
      matchPackageNames: [
        'ghcr.io/linuxserver/lidarr',
      ],
      allowedVersions: '<8',
    },
    {
      matchPackageNames: [
        'ghcr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<14',
    },
    {
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'ghcr.io/k8s-at-home/radarr',
        'ghcr.io/k8s-at-home/sonarr',
        'ghcr.io/linuxserver/jackett',
      ],
    },
    {
      // evcc/optimizer only publishes `latest` + git-SHA tags (no semver), and
      // upstream re-points `latest` at inconsistent branch builds (e.g. an old
      // root-user build with no gunicorn_conf). SHA tags are unorderable so
      // renovate can't follow them, and minimumReleaseAge can't help (bad builds
      // are old re-pushes). Freeze digest auto-updates; bump the pinned digest
      // manually after vetting the image (see the helmrelease comment).
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'evcc/optimizer',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      enabled: false,
    },
  ],
}
