{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],
  prConcurrentLimit: 40,
  rebaseWhen: 'conflicted',
  timezone: 'Australia/Sydney',
  kubernetes: {
    managerFilePatterns: [
      '/cluster/.+\\.yaml$/',
    ],
    ignorePaths: [
      'cluster/base/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/cluster/.+\\.yaml$/',
    ],
    ignorePaths: [
      'cluster/base/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *chart: (?<depName>.*?)\n *version: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/traefik/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n *tag: v(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/external-snapshotter/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?)\n *url: https://github\\.com/(?<depName>.*?)\\.git\n *ref:\n *tag: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/apps/mail/mailu/helmrelease.yaml/',
      ],
      matchStrings: [
        'docker=(?<depName>.*?)\n *mailuVersion: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.yaml$/',
      ],
      matchStrings: [
        'DOCKER_MODS: (?<depName>[^:]+):(?<currentValue>[^|\\n]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/external-dns/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?)\n *url: https://github\\.com/(?<depName>.*?)\\.git\n *ref:\n *tag: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/kube-prometheus-stack/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *tag: (?<depName>[a-zA-Z-]+)-(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/cert-manager/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n.*\\/(?<currentValue>.*?)\\/',
      ],
      datasourceTemplate: 'helm',
    },
    // Headlamp plugins. These are pinned inside `pluginsManager.configContent`,
    // which is a YAML block scalar, so no built-in manager can see them -- not
    // helm-values (it only understands image-shaped keys) and not the generic
    // chart regex above (it needs `chart:` and `version:` adjacent). Without
    // these three entries the versions would be pinned and then never looked at
    // again.
    //
    // There is no ArtifactHub datasource for Headlamp plugins, but the upstream
    // repo tags per plugin -- `flux-0.7.0`, `cert-manager-0.1.1` -- so
    // github-tags plus extractVersion gives one dependency per plugin.
    // extractVersion also does the filtering: tags that do not match are
    // ignored, so the flux entry never sees cert-manager's tags. depName is
    // made distinct from packageName so the two do not collapse into one
    // dependency on the dashboard.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/util-system/headlamp/helmrelease\\.yaml$/',
      ],
      matchStrings: [
        '- name: flux\n *source: https://artifacthub\\.io/packages/headlamp/headlamp-plugins/headlamp_flux\n *version: (?<currentValue>.*)\n',
      ],
      depNameTemplate: 'headlamp-plugin-flux',
      packageNameTemplate: 'headlamp-k8s/plugins',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^flux-(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/util-system/headlamp/helmrelease\\.yaml$/',
      ],
      matchStrings: [
        '- name: cert-manager\n *source: https://artifacthub\\.io/packages/headlamp/headlamp-plugins/headlamp_cert-manager\n *version: (?<currentValue>.*)\n',
      ],
      depNameTemplate: 'headlamp-plugin-cert-manager',
      packageNameTemplate: 'headlamp-k8s/plugins',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^cert-manager-(?<version>.+)$',
    },
    // pluginctl, the installer the sidecar runs. Pinned for the same reason the
    // plugins are: the chart's default is `latest`.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/util-system/headlamp/helmrelease\\.yaml$/',
      ],
      matchStrings: [
        'pluginsManager:\n *enabled: true\n *version: (?<currentValue>.*)\n',
      ],
      depNameTemplate: '@headlamp-k8s/pluginctl',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      matchPackageNames: [
        'ghcr.io/linuxserver/lidarr',
      ],
      allowedVersions: '<8',
    },
    {
      matchPackageNames: [
        'ghcr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<14',
    },
    {
      // Pinned by the velero server version: velero 1.9.x pairs with the
      // plugin 1.5.x line. v1.14.x breaks MinIO uploads with
      // XAmzContentSHA256Mismatch. Raise this together with the velero
      // chart, not before.
      matchPackageNames: [
        'velero/velero-plugin-for-aws',
      ],
      allowedVersions: '<1.6',
    },
    {
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'ghcr.io/k8s-at-home/radarr',
        'ghcr.io/k8s-at-home/sonarr',
        'ghcr.io/linuxserver/jackett',
      ],
    },
    {
      // traefik chart 42.0.0 raised the chart's kubeVersion floor to >=1.30.0-0;
      // the cluster is on k3s 1.25. Lift this cap together with the k8s 1.30 hop
      // (#2847). Matches both the HelmRelease chart versions and the CRD git tag
      // in cluster/crds/traefik.
      matchPackageNames: [
        'traefik',
      ],
      allowedVersions: '<42',
    },
  ],
}
