{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],
  prConcurrentLimit: 40,
  rebaseWhen: 'conflicted',
  timezone: 'Australia/Sydney',
  kubernetes: {
    managerFilePatterns: [
      '/cluster/.+\\.yaml$/',
    ],
    ignorePaths: [
      'cluster/base/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/cluster/.+\\.yaml$/',
    ],
    ignorePaths: [
      'cluster/base/',
    ],
  },
  customManagers: [
    {
      // The CNPG Cluster's operand image. Renovate's kubernetes manager only
      // looks at `image:` keys, so `imageName:` in a Cluster CR is invisible to
      // it without this, and the Postgres version would silently never update.
      //
      // currentValue is the whole tag (`18.6-standard-bookworm`) rather than
      // just the digits, because that is what the registry publishes -- a bare
      // `18.6` matches no tag and renovate would find nothing. The versioning
      // regex both orders them correctly and filters out the -minimal-,
      // -system- and datestamped tag families.
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/database-system/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\n *imageName: \\S+:(?<currentValue>\\S+)\n',
      ],
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-standard-bookworm$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *chart: (?<depName>.*?)\n *version: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/traefik/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n *tag: v(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/external-snapshotter/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?)\n *url: https://github\\.com/(?<depName>.*?)\\.git\n *ref:\n *tag: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/apps/mail/mailu/helmrelease.yaml/',
      ],
      matchStrings: [
        'docker=(?<depName>.*?)\n *mailuVersion: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.yaml$/',
      ],
      matchStrings: [
        'DOCKER_MODS: (?<depName>[^:]+):(?<currentValue>[^|\\n]+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/external-dns/.+\\.yaml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>.*?)\n *url: https://github\\.com/(?<depName>.*?)\\.git\n *ref:\n *tag: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/kube-prometheus-stack/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *tag: (?<depName>[a-zA-Z-]+)-(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/cert-manager/.+\\.yaml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n.*\\/(?<currentValue>.*?)\\/',
      ],
      datasourceTemplate: 'helm',
    },
    // k3s rollout Plans (#2837). Both Plans carry the same `spec.version`, and a
    // regex manager rewrites every occurrence, so one PR moves the pair together.
    //
    // Tracked against the k3s-io/k3s releases rather than the rancher/k3s-upgrade
    // image: the image tag sanitises `+` to `-` (SUC does that itself, see
    // `status.latestVersion`), and writing `v1.33.13-k3s2` into `spec.version`
    // would name a release that does not exist.
    //
    // The regex *versioning* matters as much as the regex match. k3s appends its
    // build as semver build metadata (`+k3s2`), and semver compares build metadata
    // as equal -- so under the default versioning a re-release that only moves
    // `+k3s1` -> `+k3s2` would never be offered. Mapping `k3s(\d+)` onto the
    // `build` group makes that comparison numeric. It also filters the tag list for
    // free: `v1.33.13-rc1+k3s1` does not match the pattern, so RCs never appear.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/system-upgrade-controller/plans\\.yaml$/',
      ],
      matchStrings: [
        'version: (?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\n',
      ],
      depNameTemplate: 'k3s',
      packageNameTemplate: 'k3s-io/k3s',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$',
    },
    // Headlamp plugins. These are pinned inside `pluginsManager.configContent`,
    // which is a YAML block scalar, so no built-in manager can see them -- not
    // helm-values (it only understands image-shaped keys) and not the generic
    // chart regex above (it needs `chart:` and `version:` adjacent). Without
    // these three entries the versions would be pinned and then never looked at
    // again.
    //
    // There is no ArtifactHub datasource for Headlamp plugins, but the upstream
    // repo tags per plugin -- `flux-0.7.0`, `cert-manager-0.1.1` -- so
    // github-tags plus extractVersion gives one dependency per plugin.
    // extractVersion also does the filtering: tags that do not match are
    // ignored, so the flux entry never sees cert-manager's tags. depName is
    // made distinct from packageName so the two do not collapse into one
    // dependency on the dashboard.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/util-system/headlamp/helmrelease\\.yaml$/',
      ],
      matchStrings: [
        '- name: flux\n *source: https://artifacthub\\.io/packages/headlamp/headlamp-plugins/headlamp_flux\n *version: (?<currentValue>.*)\n',
      ],
      depNameTemplate: 'headlamp-plugin-flux',
      packageNameTemplate: 'headlamp-k8s/plugins',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^flux-(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/util-system/headlamp/helmrelease\\.yaml$/',
      ],
      matchStrings: [
        '- name: cert-manager\n *source: https://artifacthub\\.io/packages/headlamp/headlamp-plugins/headlamp_cert-manager\n *version: (?<currentValue>.*)\n',
      ],
      depNameTemplate: 'headlamp-plugin-cert-manager',
      packageNameTemplate: 'headlamp-k8s/plugins',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^cert-manager-(?<version>.+)$',
    },
    // pluginctl, the installer the sidecar runs. Pinned for the same reason the
    // plugins are: the chart's default is `latest`.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/core/util-system/headlamp/helmrelease\\.yaml$/',
      ],
      matchStrings: [
        'pluginsManager:\n *enabled: true\n *version: (?<currentValue>.*)\n',
      ],
      depNameTemplate: '@headlamp-k8s/pluginctl',
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      // THE STAIRCASE CAP. k8s minors are gated on Longhorn, Flux and cert-manager
      // one hop at a time (#2833), so renovate is allowed to offer patches inside
      // the minor the cluster is already on, and nothing beyond it.
      //
      // Expressed as a regex rather than a `<1.34` range on purpose: the dependency
      // uses a custom regex versioning (see customManagers), and a regex
      // allowedVersions is evaluated against the raw tag, so it cannot be
      // misinterpreted by a versioning scheme that does not implement ranges.
      //
      // TO TAKE THE NEXT MINOR: do the gate checks in #2939 first, then change the
      // minor below in the same PR that lands the hop. That edit is the
      // deliberate decision; everything under it is routine.
      //
      // Patch bumps still are not automerged -- a k3s patch reboots every node in
      // sequence, which is never something to discover after the fact.
      matchDepNames: [
        'k3s',
      ],
      allowedVersions: '/^v1\\.35\\./',
    },
    {
      matchPackageNames: [
        'ghcr.io/linuxserver/lidarr',
      ],
      allowedVersions: '<8',
    },
    {
      matchPackageNames: [
        'ghcr.io/linuxserver/qbittorrent',
      ],
      allowedVersions: '<14',
    },
    {
      // The velero chart had NO cap, which is how it once reached chart v12
      // (velero 1.18) in a single renovate PR and had to be reverted. Velero's
      // own upgrade docs require the previous minor to be installed first, so
      // this walks one chart major per hop like the k3s Plans do.
      //
      // chart major <-> velero minor: 7.x <-> 1.14, 8.x <-> 1.15, 9.x/10.x <->
      // 1.16, 11.x <-> 1.17, 12.x <-> 1.18. Raise this and the plugin cap below
      // in the same PR that lands the hop.
      matchDatasources: [
        'helm',
      ],
      matchDepNames: [
        'velero',
      ],
      allowedVersions: '<8',
    },
    {
      // A Postgres MAJOR bump is a declarative offline pg_upgrade in CNPG --
      // downtime and a decision, not a routine dependency PR. Minors inside 18
      // are routine and wanted (upstream asks you to track the latest minor for
      // the major in use). Lift this in the PR that intends the major upgrade,
      // the same way the k3s cap is lifted per hop.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      allowedVersions: '/^18\\./',
    },
    {
      // Pinned by the velero server version: the plugin tracks four minors
      // behind, so velero 1.14.x pairs with the plugin 1.10.x line. Raise this
      // together with the velero chart, never the plugin alone.
      //
      // The XAmzContentSHA256Mismatch failure that originally motivated this cap
      // is an aws-sdk-go-v2 issue from plugin v1.13.x onward, documented upstream
      // for Ceph S3 and Backblaze B2, with checksumAlgorithm="" as the fix. So
      // the cap is about pairing, and v1.13+ will additionally need that config.
      matchPackageNames: [
        'velero/velero-plugin-for-aws',
      ],
      allowedVersions: '<1.11',
    },
    {
      matchDatasources: [
        'docker',
      ],
      automerge: true,
      automergeType: 'branch',
      ignoreTests: true,
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'ghcr.io/k8s-at-home/radarr',
        'ghcr.io/k8s-at-home/sonarr',
        'ghcr.io/linuxserver/jackett',
      ],
    },
  ],
}
